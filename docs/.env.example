# AI assistant dokumentasi — isi SALAH SATU.
# 1) Gemini API langsung (disarankan). Buat kunci di: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Opsional: model Gemini yang dipakai (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2) Vercel AI Gateway. Buat key di: https://vercel.com/~/ai/api-keys
AI_GATEWAY_API_KEY=

# Site URL untuk LLMs integration & sitemap
NUXT_SITE_URL=https://ui.majalengka.tech
