{
  "name": "@majalengka/design-system-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs",
    "templates/*"
  ],
  "scripts": {
    "dev": "cd docs && bun dev",
    "build": "bun run build:tokens && bun run build:css && bun run build:js && cd docs && bun run build",
    "build:tokens": "cd packages/tokens && bun run build",
    "build:css": "cd packages/css && bun run build",
    "build:vue": "cd packages/vue && bun run build",
    "test:css": "cd packages/css && bun run build",
    "publish:tokens": "cd packages/tokens && npm publish",
    "publish:css": "cd packages/css && npm publish",
    "publish:vue": "cd packages/vue && npm publish",
    "build:docs": "cd docs && bun run build",
    "generate:docs": "cd docs && bun generate",
    "preview:docs": "cd docs && bun preview",
    "build:js": "cd packages/js && bun run build",
    "publish:js": "cd packages/js && npm publish",
    "dev:disdik": "cd templates/disdik && bun run dev"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
