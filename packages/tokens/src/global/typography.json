{
  "$schema": "https://tr.designtokens.org/format/",
  "typography": {
    "fontFamily": {
      "title": { "$type": "fontFamily", "$value": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" },
      "body": { "$type": "fontFamily", "$value": "'Inter', system-ui, -apple-system, sans-serif" },
      "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', monospace" }
    },
    "scale": {
      "xs": {
        "fontSize": { "$type": "dimension", "$value": "12px" },
        "lineHeight": { "$type": "number", "$value": "1.5" },
        "$description": "Label tabel, keterangan gambar"
      },
      "sm": {
        "fontSize": { "$type": "dimension", "$value": "14px" },
        "lineHeight": { "$type": "number", "$value": "1.55" },
        "$description": "Teks bantuan, metadata, isi tabel"
      },
      "base": {
        "fontSize": { "$type": "dimension", "$value": "16px" },
        "lineHeight": { "$type": "number", "$value": "1.7" },
        "$description": "Teks isi default (min 16px untuk paragraf)"
      },
      "lg": {
        "fontSize": { "$type": "dimension", "$value": "18px" },
        "lineHeight": { "$type": "number", "$value": "1.65" },
        "$description": "Paragraf pembuka, ringkasan berita"
      },
      "xl": {
        "fontSize": { "$type": "dimension", "$value": "20px" },
        "lineHeight": { "$type": "number", "$value": "1.5" },
        "$description": "Judul kartu layanan"
      },
      "2xl": {
        "fontSize": { "$type": "dimension", "$value": "24px" },
        "lineHeight": { "$type": "number", "$value": "1.35" },
        "$description": "Heading 3"
      },
      "3xl": {
        "fontSize": { "$type": "dimension", "$value": "30px" },
        "lineHeight": { "$type": "number", "$value": "1.3" },
        "$description": "Heading 2"
      },
      "4xl": {
        "fontSize": { "$type": "dimension", "$value": "36px" },
        "lineHeight": { "$type": "number", "$value": "1.22" },
        "$description": "Heading 1 halaman dalam"
      },
      "5xl": {
        "fontSize": { "$type": "dimension", "$value": "48px" },
        "lineHeight": { "$type": "number", "$value": "1.15" },
        "$description": "Judul hero beranda"
      }
    }
  }
}
