{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Token semantik mode gelap. Kunci harus identik dengan light.json.",
  "bg": {
    "$type": "color",
    "canvas": { "$value": "{color.night.900}" },
    "base": { "$value": "{color.night.800}" },
    "elevated": { "$value": "{color.night.700}" },
    "sunken": { "$value": "{color.night.950}" },
    "tint": { "$value": "rgba(255, 255, 255, 0.06)" },
    "brand-subtle": { "$value": "{color.primary.950}" },
    "inverse": { "$value": "{color.neutral.100}" },
    "backdrop": { "$value": "rgba(0, 0, 0, 0.7)" }
  },
  "text": {
    "$type": "color",
    "strong": { "$value": "{color.neutral.100}" },
    "default": { "$value": "{color.neutral.300}" },
    "subtle": { "$value": "{color.neutral.500}" },
    "muted": { "$value": "{color.neutral.600}" },
    "inverse": { "$value": "{color.neutral.950}" },
    "brand": { "$value": "{color.primary.300}" },
    "brand-hover": { "$value": "{color.primary.200}" }
  },
  "border": {
    "$type": "color",
    "line": { "$value": "rgba(255, 255, 255, 0.12)" },
    "hairline": { "$value": "rgba(255, 255, 255, 0.06)" },
    "input": { "$value": "{color.neutral.600}" },
    "input-hover": { "$value": "{color.neutral.500}" },
    "brand-subtle": { "$value": "{color.primary.700}" },
    "focus": { "$value": "{color.primary.300}" },
    "brand": { "$value": "{color.primary.300}" },
    "danger": { "$value": "{color.danger.300}" }
  },
  "action": {
    "$type": "color",
    "primary": {
      "bg": { "$value": "{color.primary.300}" },
      "hover": { "$value": "{color.primary.200}" },
      "active": { "$value": "{color.primary.100}" },
      "fg": { "$value": "{color.primary.950}" },
      "ring": { "$value": "rgba(148, 163, 255, 0.40)" }
    },
    "secondary": {
      "bg": { "$value": "{bg.base}" },
      "hover": { "$value": "{bg.tint}" },
      "active": { "$value": "{color.night.700}" },
      "fg": { "$value": "{text.default}" },
      "border": { "$value": "{border.input}" }
    },
    "danger": {
      "bg": { "$value": "{color.danger.300}" },
      "hover": { "$value": "{color.danger.200}" },
      "active": { "$value": "{color.danger.50}" },
      "fg": { "$value": "{color.danger.950}" }
    }
  },
  "status": {
    "$type": "color",
    "success": {
      "bg": { "$value": "{color.success.950}" },
      "border": { "$value": "{color.success.800}" },
      "fg": { "$value": "{color.success.300}" }
    },
    "warning": {
      "bg": { "$value": "{color.warning.950}" },
      "border": { "$value": "{color.warning.800}" },
      "fg": { "$value": "{color.warning.300}" }
    },
    "danger": {
      "bg": { "$value": "{color.danger.950}" },
      "border": { "$value": "{color.danger.800}" },
      "fg": { "$value": "{color.danger.300}" }
    },
    "info": {
      "bg": { "$value": "{color.info.950}" },
      "border": { "$value": "{color.info.800}" },
      "fg": { "$value": "{color.info.300}" }
    }
  },
  "accent": {
    "$type": "color",
    "mango": { "$value": "{color.mango.500}" }
  }
}
