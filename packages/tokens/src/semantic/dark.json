{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Token semantik mode gelap. Harus punya kunci yang persis sama dengan light.json (dicek saat build).",
  "bg": {
    "canvas": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "base": {
      "$type": "color",
      "$value": "#151922"
    },
    "elevated": {
      "$type": "color",
      "$value": "#1C222E"
    },
    "tint": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.06)"
    },
    "sunken": {
      "$type": "color",
      "$value": "#07090E"
    }
  },
  "text": {
    "strong": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "default": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.500}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.600}"
    },
    "inverse": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.primary.300}",
      "$description": "Biru Majalengka terang, kontras AAA di latar gelap"
    }
  },
  "border": {
    "line": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.12)"
    },
    "hairline": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.06)"
    },
    "input": {
      "$type": "color",
      "$value": "#2D3748"
    },
    "focus": {
      "$type": "color",
      "$value": "{color.primary.400}"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.primary.400}"
    }
  },
  "action": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{color.primary.500}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.primary.400}"
      },
      "active": {
        "$type": "color",
        "$value": "{color.primary.300}"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "ring": {
        "$type": "color",
        "$value": "rgba(107, 125, 255, 0.35)"
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": "{bg.base}"
      },
      "hover": {
        "$type": "color",
        "$value": "{bg.tint}"
      },
      "fg": {
        "$type": "color",
        "$value": "{text.default}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.line}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "#E03131"
      },
      "hover": {
        "$type": "color",
        "$value": "#F03E3E"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    }
  },
  "color": {
    "$description": "Alias nama lama (--mjl-color-*) agar kode yang sudah ada tetap jalan. Pakai token fungsional di atas untuk kode baru.",
    "surface": {
      "canvas": {
        "$type": "color",
        "$value": "{bg.canvas}"
      },
      "card": {
        "$type": "color",
        "$value": "{bg.base}"
      },
      "sunken": {
        "$type": "color",
        "$value": "{bg.sunken}"
      },
      "overlay": {
        "$type": "color",
        "$value": "{bg.elevated}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{text.strong}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{text.subtle}"
      },
      "muted": {
        "$type": "color",
        "$value": "{text.muted}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{text.inverse}"
      },
      "link": {
        "$type": "color",
        "$value": "{text.brand}"
      },
      "linkHover": {
        "$type": "color",
        "$value": "{color.primary.200}"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$type": "color",
          "$value": "{action.primary.bg}"
        },
        "hover": {
          "$type": "color",
          "$value": "{action.primary.hover}"
        },
        "active": {
          "$type": "color",
          "$value": "{action.primary.active}"
        },
        "fg": {
          "$type": "color",
          "$value": "{action.primary.fg}"
        }
      },
      "secondary": {
        "default": {
          "$type": "color",
          "$value": "{action.secondary.bg}"
        },
        "hover": {
          "$type": "color",
          "$value": "{action.secondary.hover}"
        },
        "active": {
          "$type": "color",
          "$value": "{color.neutral.700}"
        },
        "fg": {
          "$type": "color",
          "$value": "{action.secondary.fg}"
        }
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{border.hairline}"
      },
      "default": {
        "$type": "color",
        "$value": "{border.line}"
      },
      "input": {
        "$type": "color",
        "$value": "{border.input}"
      },
      "focus": {
        "$type": "color",
        "$value": "{border.focus}"
      },
      "error": {
        "$type": "color",
        "$value": "#F87171"
      }
    }
  }
}
