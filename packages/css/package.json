{
  "name": "@majalengka/css",
  "version": "0.1.0",
  "description": "Pure CSS distribution for Majalengka Design System (zero build required)",
  "main": "dist/majalengka.css",
  "style": "dist/majalengka.css",
  "exports": {
    ".": "./dist/majalengka.css",
    "./css": "./dist/majalengka.css",
    "./min": "./dist/majalengka.min.css",
    "./core": "./dist/core.min.css",
    "./reset": "./dist/reset.min.css",
    "./components/*": "./dist/components/*",
    "./src/*": "./src/*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MajalengkaTech/design-system.git",
    "directory": "packages/css"
  },
  "homepage": "https://github.com/MajalengkaTech/design-system#readme",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "devDependencies": {
    "@majalengka/tokens": "workspace:*",
    "known-css-properties": "^0.37.0",
    "lightningcss": "^1.33.0"
  }
}
