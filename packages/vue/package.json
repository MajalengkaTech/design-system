{
  "name": "@majalengka/vue",
  "version": "0.1.0",
  "description": "Komponen Vue 3 untuk Majalengka Design System",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MajalengkaTech/design-system.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/MajalengkaTech/design-system#readme",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@majalengka/css": "^0.1.0",
    "@majalengka/js": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
